# App identity. Every value has a Junktown default in `app.config.ts`, so an
# untouched clone builds and runs without this file; copy to `.env` to change
# any of them.
#
# `EXPO_PUBLIC_*` values are inlined into the bundle by Expo's babel transform
# and are also read by the ruleset (`branding.appName`); the unprefixed ones
# are read only by `app.config.ts` under Node.

EXPO_PUBLIC_APP_NAME=Junktown Intelligence
EXPO_PUBLIC_APP_SLUG=GameCharacterManager
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_BUNDLE_IDENTIFIER=com.junktownintelligence.app
EXPO_PUBLIC_SPLASH_BACKGROUND_COLOR=#ffffff

# Changing this orphans EAS builds — it is this project's, not Lore's.
EAS_PROJECT_ID=885b4454-9ce8-4aeb-b316-e62c0b669199
EXPO_OWNER=mccarjac

# The shared GitHub repository the app syncs campaign data with.
EXPO_PUBLIC_DATA_REPO_OWNER=mccarjac
EXPO_PUBLIC_DATA_REPO_NAME=AWInvestigationsDataLibrary
EXPO_PUBLIC_DATA_REPO_BRANCH=main
